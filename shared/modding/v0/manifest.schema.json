{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netstorm:mod-manifest:0.1.0",
  "title": "Netstorm 공통 모드 선언 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion", "entry"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 32},
    "apiVersion": {"const": "0.1.0"},
    "entry": {"type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.js$"},
    "description": {"type": "string", "maxLength": 1024}
  }
}
