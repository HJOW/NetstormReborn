<Project Sdk="Microsoft.NET.Sdk">
  <!-- 원본 Win32 게임을 조작하는 AI용 CLI 및 stdio MCP 서버. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <AssemblyName>Netstorm.AnalyzeManager</AssemblyName>
    <RootNamespace>Netstorm.AnalyzeManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <!-- 리눅스용 YouTube 전용 빌드는 별도 프로젝트(portable/)이며 이 프로젝트의 공용 소스를 링크한다 -->
    <Compile Remove="portable/**" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../dotnetpj/src/Netstorm.Assets/Netstorm.Assets.csproj" />
  </ItemGroup>
</Project>
