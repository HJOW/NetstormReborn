<Project Sdk="Microsoft.NET.Sdk">
  <!-- MonoGame DesktopGL 실행 프로젝트 (Windows 10/11 · Linux 공용) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Netstorm.Game</RootNamespace>
    <AssemblyName>NetstormClone</AssemblyName>
    <!-- 고해상도 모니터에서 흐릿하게 확대되지 않도록 DPI 인식 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- MonoGame 의 네이티브 라이브러리(SDL2, OpenAL)는 NuGet 패키지가 출력 폴더에 복사한다 -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="FontStashSharp.MonoGame" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Netstorm.Assets\Netstorm.Assets.csproj" />
    <ProjectReference Include="..\Netstorm.Core\Netstorm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 한국어 글꼴 D2Coding (SIL OFL 1.1) 을 출력 폴더의 fonts/ 로 복사 -->
    <None Include="..\..\fonts\D2Coding-Ver1.3.2-20180524-all.ttc" Link="fonts\D2Coding-Ver1.3.2-20180524-all.ttc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
