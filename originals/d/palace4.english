[Header]
missionType = "Tutorial"

missionNumber = 4
moreGeysers = 0

myStartMoney = 6500
myTech = ""
myAllyList = ""

title="Priesthood"

ai6Name = "~iLord Kalrek"
ai6Tech = "windbattery;suncannon;sunarcher;sunblocker;sunaviary;sunballoon;sunwalker"
ai6StartMoney = 1500
ai6GeyserAttachments = 5
ai6Collectors = 5
ai6TimeBetweenMoves = 1
ai6AllyList = ""
ai6color = yellow
ai6Ability="!USE_PRIEST_TO_COLLECT;!BUILD_DAIS"
ai6BridgeDrawRate = 3


[inti]
<$Config,atmentor=1>


[@1]
<$Config,atobjective1=0>
<$Config,atobjective2=0>
<$Config,atobjective3=0>
<$Config,atobjective4=0>
<$Config,atobjective5=0>
<$Config,atobjective6=0>
<$Config,atobjective7=0>
<$Config,atobjective8=0>
<$Config,atweapon0=0>
<h2>~iKalrek</h2>
<p>You are almost ready.
$Timeout=3,DoNothing,0

[@2]
<h2>~iKalrek</h2>
<p>You have become skilled in the ways of battle.
$Timeout=5,DoNothing,0

[@3]
<h2>~iKalrek</h2>
<p>And have show that you are indeed a warrior.
$Timeout=4,DoNothing,0

[@4]
<h2>~iKalrek</h2>
<p>Now is the time to see how well you have learned.
$Timeout=4,DoNothing,0

[@5]
<h2>~iKalrek</h2>
<p>For once you have defeated me you shall be able to seek out your destiny as a High Priest of Nimbus!
$Timeout=7,DoNothing,0

[@6]
<h2>~iKalrek</h2>
<p>I shall give you the victory once you have destroyed my temple or have captured me.
$Timeout=5,DoNothing,0

[@7]
<h2>~iKalrek</h2>
<p>Now let the battle begin!
$Timeout=3,DoNothing,0

[@300]
<h2>~iKalrek</h2>
<p>Come now!  I was expecting more of a fight from you.
$Timeout=4,DoNothing,0

[@600]
<h2>~iKalrek</h2>
<p>You dissapoint me, why do you hesistate?
$Timeout=4,DoNothing,0

[@900]
<h2>~iKalrek</h2>
<p>What is the matter with you today?
$Timeout=4,DoNothing,0

[@1200]
<h2>~iKalrek</h2>
<p>I truly thought that you would have done far better than this pathetic display.
$Timeout=5,DoNothing,0



[Options]

[A.]
<h2>Priesthood</h2>
<i>"It is easy to manipulate the uneducated."<br>
-- Aquan Zeral, Teacher</i>  
<p>Your training nears it's compleation.  Now you must prove yourself worthy to become a High Priest of Nimbus....

<?!{atweapon0}>$Button=Prepare,Tell,OldTech</?>
<?{atweapon0}>$Button=Review Knowledge,ShowTechnology,55</?>
$Button=Play Mission,DoNothing,0

