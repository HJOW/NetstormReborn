[Header]
missionType = "Tutorial"

missionNumber = 2
moreGeysers = 1
randomGeysers = 1
denySalvage = 1
myStartMoney = 5000
myTech = "sunWalker;sunArcher;sunCannon;sunAviary;sunBlocker;sunFence;sunBalloon;sunAviary;windArcher;windBattery"

title="Low Priests Rise to the Call"

ai2Name = "Low Priest of Rain"
ai2Tech = "sunWalker;sunArcher;rainBattery;rainCannon;rainWalker;sunCannon;rainFence"
ai2StartMoney = 3000
ai2GeyserAttachments = 2
ai2Collectors = 3
ai2TimeBetweenMoves = 2
ai2AllyList = "3;4"
ai2color = red
ai2Ability = "!USE_PRIEST_TO_COLLECT"
ai2BridgeDrawRate = 3

ai3Name = "Low Priest of Wind"
ai3Tech = "sunWalker;sunarcher;windBattery;windArcher;windWalker;sunCannon;windBlocker"
ai3StartMoney = 3000
ai3GeyserAttachments = 2
ai3Collectors = 3
ai3TimeBetweenMoves = 2
ai3AllyList = "2;4"
ai3color = white
ai3Ability = "!USE_PRIEST_TO_COLLECT"
ai3BridgeDrawRate = 3

ai4Name = "Low Priest of Thunder"
