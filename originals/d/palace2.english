[Succeeded][BadTeamDead]

[ai6TempleHalfDead]
<h2>~iKalrek</h2>
<p>Hahaha good, so you do have some skills.
$Timeout=3,DoNothing,0

[ai6TempleDead]
<h2>~iKalrek</h2>
<p>Congratulations, you pass.
<$Config,atobjective1=1>

$Timeout=3,DoNothing,0

[tech1]
<h2>~iKalrek</h2>
<p>As a reward for passing my test I offer you this.
<?!{atweapon20}>$Menu=~wSun Cannon,Tell,suncannon</?>
<?!{atweapon21}>$Menu=~wSun Disc Thrower,Tell,sunarcher</?>
<?!{atweapon22}>$Menu=~wStone Tower,Tell,sunblocker</?>

[tech2]
<h2>~iKalrek</h2>
<p>Very Well.
$Button=Ok,Tell,TechSave
$Timeout=3,Tell,TechSave

[tech3]
<h2>~iKalrek</h2>
<p>Come, there is still much to be done.
$Button=Ok,Tell,done1
$Timeout=3,Tell,done1

[done1]
