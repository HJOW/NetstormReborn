[Header]
missionType = "Tutorial"

missionNumber = 2
moreGeysers = 0

myStartMoney = 6500
myTech = ""
myAllyList = ""

title="First Lesson"


ai6Name = "~iLord Kalrek"
ai6Tech = "sunaviary;sunblocker;suncannon"
ai6StartMoney = 1500
ai6GeyserAttachments = 4
ai6Collectors = 5
ai6TimeBetweenMoves = 0
ai6AllyList = ""
ai6color = yellow
ai6Ability="!BUILD_BRIDGES"
ai6BridgeDrawRate = 15

[@1]
<h2>~iKalrek</h2>
<p>Now let's see what you are capable of.
<$Config,atobjective1=0>
<$Config,atobjective2=0>
<$Config,atobjective3=0>
<$Config,atobjective4=0>
<$Config,atobjective5=0>
<$Config,atobjective6=0>
<$Config,atobjective7=0>
<$Config,atobjective8=0>
<$Config,atweapon0=0> </?>  
$Timeout=3,DoNothing,0

[@2]
<h2>~iKalrek</h2>
<p>Your task is simple:  Destroy my temple.  

$Timeout=3,DoNothing,0

[@3]
<h2>~iKalrek</h2>
<p>I'll warn you now, an all out frontal assault will likely fail. 

$Timeout=4,DoNothing,0

[@4]
<h2>~iKalrek</h2>
<p>You have ten minutes.

[@5]
<h2>~iKalrek</h2>
<p>And I do hope I don't have to remind you to prepare your technolgy for use.  I don't tolerate incompetence.

$Timeout=7,DoNothing,0

[@485]
<h2>~iKalrek</h2>
<p>I suggest you make haste, you only have two minutes left.

$Timeout=4,DoNothing,0

[@605]

<?!{atpriest1}>
<h2>~iKalrek</h2>
<p>Cutting it close are we?  Well at least you passed.

$Timeout=4,DoNothing,0
</?>

<?{atpriest1}>

<h2>~iKalrek</h2>
<p>You dissapoint me.  Perhaps you are not ready for priesthood yet...

$Button=Ok,Tell,Failed
$Timeout=5,Tell,Failed
</?>


[Options]

[A.]
<h2>Lessons</h2>
<i>"Experience is one of the greatest teachers one can have."<br>
-- Book of Nimbus</i>  
<p>You have been accepted by Lord Kalrek.  As his student he expects much of you.  Alreadly he is testing your abilities as a warrior.

<?!{atweapon0}>$Button=Prepare,Tell,OldTech</?>
<?{atweapon0}>$Button=Review Knowledge,ShowTechnology,55</?>
