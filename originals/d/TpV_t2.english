[Header]
missionType = "Tutorial"

missionNumber = 4
title="Day Two"


myStartMoney = 10000
myTech = ""

[INIT]


[Options]


[A.]
<h2>~yMorning</h2><P>
As you awake, you ask yourself<p>
 "~iWas I visited be the Furies?~."<p>
You think for a minute.<p>
"~iCould I be the one?~."<br>
~[Iresidence.6]

$Button=Leave Missions,MissionAbort,0
$Button=See Progress,tell,Stats
$Button=Rest,tell,Rest


[REST]
<h2>~yEvening</h2><P>
The Sun has set and you have gone to bed.
As you fall into a deep sleep, you hear a voice.<p>
<i>{TpVguide}</i> <?{Tp_name}>{Tp_yourname}, </?>The time has come for you to be tested.
<P>
Selected a tech for your Second trial.
$Checked=Sun,tell,Sun,0,{TpVc11}
$Checked=Wind,tell,Wind,0,{TpVc21}
$Checked=Rain,tell,Rain,0,{TpVc31}
$Checked=Thunder,tell,thunder,0,{TpVc41}
$Checked=All,tell,All,0,{TpVc51}
$OnExit= ,MissionBegin,TpVfire


[SUN]
<$config,TpVc1=1>
<$config,TpVc2=0>
<$config,TpVc3=0>
<$config,TpVc4=0>
<$config,TpVc5=0>
<$config,TpVmyTech1={TpVtechSun;}>
<$config,TpVmyTech2={TpVtechSun2;}>

[WIND]
<$config,TpVc1=0>
