<Project>
  <!-- 모든 C# 프로젝트 공통 설정 -->
  <PropertyGroup>
    <!-- 대상 프레임워크: .NET 10 LTS (MonoGame 3.8.5 패키지는 net8.0 대상이지만 net10.0 에서 그대로 사용 가능) -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 같은 소스에서 같은 바이너리가 나오도록 결정적 빌드 -->
    <Deterministic>true</Deterministic>
    <!-- 한국어 주석·문자열을 포함한 소스는 UTF-8 로 저장한다 (AGENTS.md) -->
    <Company>Netstorm Clone Project</Company>
    <Product>Netstorm Clone</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
