<Project Sdk="Microsoft.NET.Sdk">
  <!-- 유일한 MonoGame 실행 프로젝트다. 실제 논리 화면/입력/장치를 Netstorm.Client에서 빌린다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Netstorm.Game</RootNamespace>
    <!-- 진단 stdout을 지원하면서 배포 게임 이름은 기존 Netstorm.exe를 승계한다. -->
    <AssemblyName>Netstorm</AssemblyName>
    <Version>11.1.0</Version>
    <InformationalVersion>11.01</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright 2026 HJOW</Copyright>
    <ApplicationIcon>../../../assets/Netstorm.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- DirectSound의 실제 Lock 구간을 복사 없는 Span으로 빌리는 좁은 플랫폼 경계에 사용한다. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDataSourceDirectory>$(MSBuildProjectDirectory)/../../../assets/game-data</GameDataSourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>
  <ItemGroup>
    <!-- 한국어 글꼴과 라이선스는 실행 파일에 내장하지 않고 외부 fonts에 배치한다. -->
    <None Include="../../../fonts/Galmuri11Bitmap-Regular-2.40.4.ttf;../../../fonts/Galmuri11Bitmap-Bold-2.40.4.ttf;../../../fonts/Galmuri11-LICENSE.txt" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 분석 원본 대신 관리 게임 자료를 개발/배포 출력에 함께 복사한다. -->
    <Content Include="$(GameDataSourceDirectory)/**/*" Link="game-data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 불완전한 데이터와 원본 실행 파일의 혼입을 빌드에서 거부한다. -->
  <Target Name="ValidateGameData" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GameDataSourceDirectory)/netstorm.tarc') Or !Exists('$(GameDataSourceDirectory)/d/_shapes.shp') Or !Exists('$(GameDataSourceDirectory)/d/GIFCLOUD.COL')" Text="관리 게임 자료의 netstorm.tarc, d/_shapes.shp, d/GIFCLOUD.COL이 필요합니다." />
    <ItemGroup>
      <UnexpectedGameExecutable Include="@(Content)" Condition="'%(Content.Extension)' == '.exe' Or '%(Content.Extension)' == '.dll' Or '%(Content.Extension)' == '.php'" />
    </ItemGroup>
    <Error Condition="'@(UnexpectedGameExecutable)' != ''" Text="게임 자료에 실행 파일·라이브러리·서버 스크립트가 포함됐습니다: @(UnexpectedGameExecutable)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Netstorm.Client\Netstorm.Client.csproj" />
    <!-- 시작 흐름의 단독 Zone 설치(LocalMissionZone)에 실제 전송 모듈을 쓴다. R5·10단계 로컬 네트워크까지 기록 갈고리로만 둔다. 2026-11-12 R4 실제 호스트·월드 조립(0.407)에서 추가됐다. -->
    <ProjectReference Include="..\Netstorm.Net\Netstorm.Net.csproj" />
  </ItemGroup>
</Project>
