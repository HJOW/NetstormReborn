<Project Sdk="Microsoft.NET.Sdk">
  <!-- 게임 규칙·화면 계산 등 Core 테스트 (xUnit v3). MonoGame 없이 헤드리스로 실행한다 -->
  <PropertyGroup>
    <!-- xUnit v3 테스트 프로젝트는 실행 파일로 빌드한다 -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Netstorm.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netstorm.Core\Netstorm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 원본 exe 없이 다리 표를 검증하는 정적 추출 자료를 테스트 출력에 복사한다. -->
    <None Update="Fixtures/bridge-tables.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- cpppj 콘솔 월드 덤프의 미션 시작 상태. x86 실행 기대값과 출처를 구분한다 (tools/export_cpp_world.py). -->
    <None Update="Fixtures/world-start-1078.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- 벽/게임 시계의 독립 PE 실행 자료. 두 x87 관찰 중 기본 53비트 모드를 대조한다. -->
    <None Update="Fixtures/clockkernel-x86.tsv" TargetPath="X86/clockkernel-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- C++ 기대값을 링크로 공유하여 별도 사본이 서로 어긋나지 않게 한다. -->
    <None Include="../../../cpppj/tests/fixtures/bridge-x86.tsv" Link="X86/bridge-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/surface-x86.tsv" Link="X86/surface-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/bridgedecay-x86.tsv" Link="X86/bridgedecay-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/graph-x86.tsv" Link="X86/graph-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/sid-x86.tsv" Link="X86/sid-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/hash-x86.tsv" Link="X86/hash-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/renderer-x86.tsv" Link="X86/renderer-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/display-x86.tsv" Link="X86/display-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- 공통 미션 프레임·안내 정지·단계 증가·재지연의 원본 PE 독립 관찰 328개 (2026-10-15 감사 D02). -->
    <None Include="../../../cpppj/tests/fixtures/missionframe-x86.tsv" Link="X86/missionframe-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- Player 로그인·방향별 동맹·AI 부착/해제의 원본 PE 독립 관찰 608개 (2026-10-15 감사 D03). -->
    <None Include="../../../cpppj/tests/fixtures/player-participation-x86.tsv" Link="X86/player-participation-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- Totalmade 허용 표·세 누적 장부·부류 합산(Total 행)과 Early1 단계 판정(Stage 행)의 원본 PE 독립 관찰 (2026-10-15 감사 D14/D05). -->
    <None Include="../../../cpppj/tests/fixtures/tutorial-one-x86.tsv" Link="X86/tutorial-one-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/X86Fixture.cs" Link="Shared/X86Fixture.cs" />
    <!-- 원본 월드 코어 W02 첫 조각: 타입별 생성자 주소 표 359행, 기본 생성·Take 1,648행, 파생 생성자 7,468행의 원본 PE 독립 관찰 (10.78 행만 쓴다). -->
    <None Include="../../../cpppj/tests/fixtures/constructors-x86.tsv" Link="X86/constructors-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/creation-x86.tsv" Link="X86/creation-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/derived-x86.tsv" Link="X86/derived-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- 연결한 fixture 의 SHA-256 목록과 그 검사. cpppj 가 fixture 를 다시 만들면 실패해 재대조를 요구한다 (W01, 2026-10-16). 갱신: dotnetpj/tools/cpp_sync.py -->
    <None Include="../Shared/cpp-fixture-manifest.tsv" Link="X86/cpp-fixture-manifest.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/CppFixtureManifest.cs" Link="Shared/CppFixtureManifest.cs" />
    <Compile Include="../Shared/CppFixtureManifestTests.cs" Link="Shared/CppFixtureManifestTests.cs" />
  </ItemGroup>
</Project>
