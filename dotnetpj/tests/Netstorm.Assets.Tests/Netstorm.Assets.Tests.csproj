<Project Sdk="Microsoft.NET.Sdk">
  <!-- 원본 포맷 로더 테스트 (xUnit v3). 저장소의 클론 데이터를 사용하며 누락은 실패다. -->
  <PropertyGroup>
    <!-- xUnit v3 테스트 프로젝트는 실행 파일로 빌드한다 -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Netstorm.Assets.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netstorm.Assets\Netstorm.Assets.csproj" />
    <!-- X86ConfigObjectTests가 Netstorm.Core.Original.Config를 직접 구동한다. fixture 소비자(Assets) 규칙에 따라 검사는 Assets.Tests에 둔다. -->
    <ProjectReference Include="..\..\src\Netstorm.Core\Netstorm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 원본 실행 없이 C++와 동일한 기계어 결과를 검사한다. -->
    <None Include="../../../cpppj/tests/fixtures/original-x86.tsv" Link="X86/original-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/config-x86.tsv" Link="X86/config-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../cpppj/tests/fixtures/options-x86.tsv" Link="X86/options-x86.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/X86Fixture.cs" Link="Shared/X86Fixture.cs" />
    <!-- 연결한 fixture 의 SHA-256 목록과 그 검사. cpppj 가 fixture 를 다시 만들면 실패해 재대조를 요구한다 (W01, 2026-10-16). 갱신: dotnetpj/tools/cpp_sync.py -->
    <None Include="../Shared/cpp-fixture-manifest.tsv" Link="X86/cpp-fixture-manifest.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/CppFixtureManifest.cs" Link="Shared/CppFixtureManifest.cs" />
    <Compile Include="../Shared/CppFixtureManifestTests.cs" Link="Shared/CppFixtureManifestTests.cs" />
    <!-- C++의 정적 자산 메타데이터는 x86 실행 기대값과 출처를 구분한다. -->
    <None Update="Fixtures/type-metadata-1078.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
