{
  "name": "NetstormWeb",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "webpack --mode production && node tools/check-bundle-size.js",
    "build:dev": "webpack --mode development",
    "check-bundle": "node tools/check-bundle-size.js",
    "ensure-bundle": "node tools/ensure-bundle.js",
    "prestart": "node tools/ensure-bundle.js",
    "start": "node server.js",
    "prepare-assets": "node tools/prepare-assets.js",
    "check-assets": "node tools/prepare-assets.js --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1"
  }
}
