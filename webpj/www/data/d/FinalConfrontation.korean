[Header]
missionType = "Tutorial"

missionNumber = 1

myStartMoney = 1200
myTech = "all"

aiName = "플레이어"
aiMoneyRechargeRate = 8    // About 3 minutes to get from 0 to reasonable wealth.
aiTimeBetweenMoves = 2
aiCollectors = 3
aiGeyserAttachments = 3
aiAllyList = "2;3;4;5"

// First enemy to the upper right
ai2Name = "썬더의 군주"
ai2Tech = "thunderBattery;bulf;thunderCannon;thunderBlocker;thunderArcher"
ai2StartMoney = 0

// Second enemy in the middle of the map
ai3Name = "레인의 군주"
ai3Tech = "rainBattery;rainWalker;rainCannon;rainAviary;rainBlocker;rainBalloon"
ai3StartMoney = 0

// Lower-right corner enemy
ai4Name = "윈드의 군주"
ai4Tech = "windBattery;windWalker;windArcher;windAviary;windBlocker;windBalloon"
ai4StartMoney = 0
ai4Ability = "!ATTACH_TO_ENEMY_ISLAND;!ENCIRCLE_ENEMY_ISLAND"

// Lower-right corner enemy
ai5Name = "스톰 군주"
ai5Tech = "sunWalker;thunderBlocker"
ai5Collectors = 0
ai5GeyserAttachments = 0
ai5StartMoney = 0
ai5Ability = "!COLLECT_STORM_POWER;!ATTACH_TO_ENEMY_ISLAND;!ENCIRCLE_ENEMY_ISLAND"

title="최후의 대결"

[A.]
<h2>최후의 대결</h2>
<i>"요새에 다가가는 동안 모든 것이 고요했지만 공기에는 이미 어쩐지
다가올 전투와 임박한 우리의 죽음의 악취가 짙게 배어 있었다."<br>
--트린 허스퍼린츠의 일기</i>
<p>
대담한 기동으로 당신의 섬이 적진 깊숙이, 그들의 사악한 제국의
심장부로 들어왔습니다!
<p>
이제 윈드, 레인, 썬더의 어둠의 왕자들이 지키는 마지막 요새를 찾았습니다.
전투에서 그들을 물리치고 궁극의 승리를 차지하세요!

$Button=지식 보기,ShowTechnology,55
$Button=미션 시작,DoNothing,0


[Succeeded][BadTeamDead]
<h2>성공!</h2>
<p>
이제 님버스를 다스리는 것은 오직 당신뿐임을 알리세요! 온 세상이
당신의 궁극의 힘의 그늘 아래 서게 하세요! 어둠의 군주들이 배를
땅에 대고 기어와 목숨을 구걸하게 하세요! 퓨리가 영원히
당신의 뜻을 따르게 하세요!
<$Config,Done{mission.fileName}=1>
$Button=확인,MissionAbort,1


[Failed]
<h2>실패!</h2>
<p>
당신은 님버스를 궁극의 어둠에서 구할 마지막 희망이었지만
실패했습니다. 당신의 무례함 때문에 어둠의 군주들은 모든 님버스인이
영원히 가난과 병과 노역 속에서 살아가도록 선포했습니다.
$Button=계속,Tell,TryAgain

[END]
