// 같은실제Session의생존brain/반납·재생성에일반reportingwriter가연결되는지검사한다.
#include "client/AiDebugCommandInput.h"
TEST_CASE(CampaignSession_AiDebugUsesCurrentBodyAndStableClientWords) {
    const auto& assets=netstorm::test::dudespawn::Assets(OriginalEdition::Patch1078);SessionServicesFixture external;auto services=external.Services();auto globals=std::make_shared<ClientGameplayGlobals>();services.gameplayGlobals=globals;
    services.ai.allocationBytes=[](auto bytes) { std::fill(bytes.begin(),bytes.end(),std::uint8_t{0x71}); };services.ai.participation.clearChat=[](auto) {};services.ai.participation.addChat=[](auto,auto,auto) {};services.missionOutcome.demo=[] { return 0U; };services.ai.assertion=[](std::string_view text) { throw std::logic_error(std::string(text)); }; //커널/전략프레임·공중3종·공격·포획희생·MP를실행하지않는다.
    auto fort=FortTemplate::Parse(assets.files.Read("d/thewarbegins.fort"),assets.game.TypeTable());RawCampaignSession session(assets.game,assets.files,std::move(fort),"thewarbegins",std::move(services));session.Load();
    const auto token=session.CreateAi(2,SessionAiSettings("Debug command AI","sunCannon"));CHECK(token && Get(session.AiMemory().Bytes(token),0xb00)==0);const auto now=session.Core().processState.now;const auto sp=session.Sp(2);const auto packets=external.packets.size(),allocations=session.AiMemory().Allocations().size();const auto before=std::vector<std::uint8_t>(session.AiMemory().Bytes(token).begin(),session.AiMemory().Bytes(token).end());
    CHECK(session.DispatchAiDebugCommand({kAiReportingCommand,99,2}));auto expected=before;Put(expected,0xb00,1);CHECK(std::equal(expected.begin(),expected.end(),session.AiMemory().Bytes(token).begin()));CHECK(session.DispatchAiDebugCommand({kAiReportingCommand,0,2}));CHECK(std::equal(before.begin(),before.end(),session.AiMemory().Bytes(token).begin()));
    CHECK(session.DispatchAiDebugCommand({kDebugSwitchCommand,0,0x52f3cc}) && globals->ReadDebugWord(0x52f3cc)==29);CHECK(session.DispatchAiDebugCommand({kDebugSwitchCommand,0,0x52f3cc}) && globals->ReadDebugWord(0x52f3cc)==99);CHECK(session.Core().processState.now==now && session.Sp(2)==sp && external.packets.size()==packets && session.AiMemory().Allocations().size()==allocations);
    session.RemoveAi(2);CHECK(session.DispatchAiDebugCommand({kAiReportingCommand,0,2}) && !session.AiMemory().Contains(token));const auto next=session.CreateAi(2,SessionAiSettings("Replacement debug AI","sunCannon"));CHECK(next && next!=token);CHECK(session.DispatchAiDebugCommand({kAiReportingCommand,0,2}) && Get(session.AiMemory().Bytes(next),0xb00)==1);session.RemoveAi(2);
}
