// 실제 일반 전투 Session의 기존 AI 소유 메모리·지갑 reader·반납 수명을 직접 writer와 연결한다.
TEST_CASE(CampaignSession_AiDirectCommandsShareCurrentBrainAndExistingWalletReader) {
    const auto& assets=netstorm::test::dudespawn::Assets(OriginalEdition::Patch1078);SessionServicesFixture external;auto services=external.Services();
    services.ai.allocationBytes=[](auto bytes) { std::fill(bytes.begin(),bytes.end(),std::uint8_t{0x71}); };services.ai.participation.clearChat=[](auto) {};services.ai.participation.addChat=[](auto,auto,auto) {};services.missionOutcome.demo=[] { return 0U; };services.ai.assertion=[](std::string_view text) { throw std::logic_error(std::string(text)); }; // 실제 생성만 쓰며 Kernel/전략 프레임·공중3종·MP는 실행하지 않는다.
    auto fort=FortTemplate::Parse(assets.files.Read("d/thewarbegins.fort"),assets.game.TypeTable());RawCampaignSession session(assets.game,assets.files,std::move(fort),"thewarbegins",std::move(services));
    session.SetAiParameter(0);session.SetAiParameter(8); //원문 low3 owner0은 설치 전에도 실제 저장소를 요구하지 않는다.
    CHECK(Throws([&] { session.CrankAiMoney(); }) && Throws([&] { session.SetAiParameter(2); }));session.Load();session.CrankAiMoney();session.SetAiParameter(2);CHECK(!session.Participation().Brain(2));
    const auto token=session.CreateAi(2,SessionAiSettings("Direct command AI","sunCannon"));CHECK(token && session.Participation().Brain(2)==token);const auto sp=session.Sp(2);const auto now=session.Core().processState.now;const auto allocations=session.AiMemory().Allocations().size(),packets=external.packets.size();const auto before=std::vector<std::uint8_t>(session.AiMemory().Bytes(token).begin(),session.AiMemory().Bytes(token).end());
    session.CrankAiMoney();CHECK(session.AiMoney(2)==30000 && session.Sp(2)==sp);session.SetAiParameter(0xffff0002U);session.SetAiParameter((3U<<16)|(4U<<4)|2U);
    auto expected=before;Put(expected,0x2d8,30000);Put(expected,0x220,0xbf800000U);Put(expected,0x600,0xbf800000U);Put(expected,0x24c,3);CHECK(std::equal(expected.begin(),expected.end(),session.AiMemory().Bytes(token).begin()));CHECK(session.Sp(2)==sp && session.Core().processState.now==now && session.AiMemory().Allocations().size()==allocations && external.packets.size()==packets);
    session.RemoveAi(2);CHECK(!session.AiMemory().Contains(token));session.CrankAiMoney();session.SetAiParameter(2);const auto replacement=session.CreateAi(2,SessionAiSettings("Replacement command AI","sunCannon"));CHECK(replacement && replacement!=token && session.Participation().Brain(2)==replacement);session.CrankAiMoney();CHECK(session.AiMoney(2)==30000 && Get(session.AiMemory().Bytes(replacement),0x2d8)==30000);session.RemoveAi(2);
}
