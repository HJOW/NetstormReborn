+// 값 복사/이동은 alias를 암묵 전파하지 않고 대입은 목적지의 기존 binding을 유지한다.
+TEST_CASE(SubscriberGlobals_CopyMoveAndCrossAliasAssignment) {
+    ClientSubscriberGlobals owner;owner.MySubscriber()=17;owner.LoginSubscriber()=29;
