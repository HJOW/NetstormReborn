$Button=Close,DoNothing,0
[END]

[PlayerList]
<h2>Players in zone {LOCALZONE}</h2>
<p>{TIME}Players {VIEWMIN} through {VIEWMAX}</p>
{PLAYERLIST}
{NAVMENU}
$Button=Close,DoNothing,0
[END]

[Player]
<p>~y{NAME}~w (player {ID}, subscriber {SID})<br>
Address {IP}; version {MAJOR}.{MINOR}; battle {BATTLE}, slot {SLOT}.<br>
{MCOLOR}<a href="cmd:Tell,ZSEND(ADMIN,SHUTUP,{ZONE}X{ID})">Mute {SHUTUP}</a>~w |
{ACOLOR}<a href="cmd:Tell,ZSEND(ADMIN,ADMIN,{ZONE}X{ID})">Administrator {ADMIN}</a>~w |
<a href="cmd:Tell,ZSEND(ADMIN,KICK,{ZONE}X{ID})">Disconnect</a> |
<a href="cmd:Tell,ZSEND(ADMIN,FORTBAN,{ZONE}X{ID})">Ban subscriber</a> |
<a href="cmd:Tell,ZSEND(ADMIN,IPBAN,{ZONE}X{ID})">Ban address</a></p>
[END]

[NEXTPLAYER]
<p>
<?g {BACK}=0><a href="cmd:Tell,ZSEND(ADMIN,GETPLAYER,{ZONE}X{BACK})">Previous</a> | </?>
<?le {START}=34><a href="cmd:Tell,ZSEND(ADMIN,GETPLAYER,{ZONE}X{START})">Next</a></?>
<?g {START}=34><?l {BACK}=28><a href="cmd:Tell,ZSEND(ADMIN,GETPLAYER,{ZONE}X34)">Next</a></?></?>
</p>
[END]
