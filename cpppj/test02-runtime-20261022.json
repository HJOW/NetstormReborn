    "executedReaderSource": "# -*- coding: utf-8 -*-\n\"\"\"현재 호스트의 실행 예외로 TEST02 작업본을 열고 원본 슬롯을 읽은 뒤 세션을 닫는다.\"\"\"\nimport ctypes\nfrom ctypes import wintypes\nimport json\nfrom pathlib import Path\nimport struct\nimport sys\n\nROOT = Path(__file__).resolve().parents[2]  # 현재 저장소 루트이며 보호 원본에는 쓰지 않는다.\nsys.path.insert(0, str(ROOT / 'tools'))\nfrom analyze_test02_construct import Run\n\nWORK = Path(__file__).resolve().parent  # 실행/화면/읽은 원문은 Git 제외 작업 폴더에 보존한다.\nrun = Run(WORK)\ntry:\n    run.boot_to_battle()\n    status = run.step('status')\n    session = json.loads((run.d.session_dir / 'session.json').read_text(encoding='utf-8'))\n    kernel = ctypes.WinDLL('kernel32', use_last_error=True)\n    kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]\n    kernel.OpenProcess.restype = wintypes.HANDLE\n    kernel.ReadProcessMemory.argtypes = [wintypes.HANDLE, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t)]\n    kernel.CloseHandle.argtypes = [wintypes.HANDLE]\n    handle = kernel.OpenProcess(0x1010, False, session['processId'])\n    if not handle: raise ctypes.WinError(ctypes.get_last_error())\n    try:\n        def read(address, size):\n            \"\"\"대상 프로세스의 지정 범위를 읽기만 하며 부분 읽기는 실패로 보고한다.\"\"\"\n            buffer = ctypes.create_string_buffer(size)\n            received = ctypes.c_size_t()\n            if not kernel.ReadProcessMemory(handle, address, buffer, size, ctypes.byref(received)) or received.value != size:\n                raise ctypes.WinError(ctypes.get_last_error())\n            return buffer.raw\n\n        base = struct.unpack('<I', read(0x5c8464, 4))[0]\n        pool = read(base, 23000 * 50)\n        (WORK / 'pool.bin').write_bytes(pool)\n        found = []\n        # 실제 일반/서버 영역의 살아 있는 해당 자산만 뽑고 원문도 함께 보존한다.\n        for sid in range(5, 23000):\n            raw = pool[sid*50:(sid+1)*50]\n            if raw[10] not in (85, 88, 89, 122, 123, 124, 125, 135, 158) or raw[11] & 3: continue\n            children = []\n            child = struct.unpack_from('<H', raw, 6)[0]\n            # 현재 내용물의 실제 링크를 읽고 손상/순환이면 원문 판단을 멈춘다.\n            while child and len(children) < 64:\n                if child >= 23000 or any(item['sid'] == child for item in children): raise ValueError('invalid content chain')\n                body = pool[child*50:(child+1)*50]\n                children.append(dict(sid=child, raw=body.hex(), type=body[10], kind=struct.unpack_from('<H', body, 18)[0], flags=struct.unpack_from('<H', body, 20)[0]))\n                child = struct.unpack_from('<H', body, 4)[0]\n            found.append(dict(sid=sid, type=raw[10], flags=raw[11], owner=raw[34], qa=struct.unpack_from('<H', raw, 12)[0],\n                              x=struct.unpack_from('<f', raw, 14)[0], y=struct.unpack_from('<f', raw, 18)[0],\n                              hp=struct.unpack_from('<i', raw, 26)[0], raw=raw.hex(), children=children))\n        result = dict(session=run.d.session_id, pid=session['processId'], poolAddress=hex(base), objects=found)\n        (WORK / 'scene.json').write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\n', encoding='utf-8')\n        print(json.dumps(dict(session=run.d.session_id, objects=[{key: entry[key] for key in ('sid','type','owner','qa','x','y','hp')} for entry in found])))\n    finally:\n        kernel.CloseHandle(handle)\nfinally:\n    if run.d.session_id: run.step('end')\n    run.d.close()\n",
