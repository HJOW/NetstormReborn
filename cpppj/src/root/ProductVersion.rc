// 새 R.exe의 Windows 파일 속성에 게임과 같은 제품 버전11.01을 제공한다.
#include <windows.h>
#include "client/ProductVersion.h"
1 VERSIONINFO
FILEVERSION NETSTORM_PRODUCT_VERSION_MAJOR,NETSTORM_PRODUCT_VERSION_MINOR,0,0
PRODUCTVERSION NETSTORM_PRODUCT_VERSION_MAJOR,NETSTORM_PRODUCT_VERSION_MINOR,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NetStorm Root Server " NETSTORM_PRODUCT_VERSION_TEXT "\0"
            VALUE "FileVersion", NETSTORM_PRODUCT_VERSION_TEXT "\0"
            VALUE "ProductName", "NetStorm\0"
            VALUE "ProductVersion", NETSTORM_PRODUCT_VERSION_TEXT "\0"
            VALUE "OriginalFilename", "R.exe\0"
            VALUE "Comments", "Developed by HJOW with AI assistance.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
