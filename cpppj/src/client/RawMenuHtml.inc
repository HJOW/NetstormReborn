// 같은 Impl의 실제 HTML 부모/본문/돌 버튼 저장소를 원문 본체에 연결한다.
void BindHtml(RawHtmlWindowContext context) { // 같은 Client의 장기 상태에 한 번만 연결한다.
    if (assets.Edition()!=o::OriginalEdition::Patch1078 || !context.globals || !context.wallSeconds) throw std::invalid_argument("HTML 실제10.78 Client 전역/벽 시각 필요");
    if (htmlContext) { if (htmlContext->globals!=context.globals) throw std::logic_error("HTML 다른 Client 소유자 연결 불가");return; }htmlContext=std::move(context);
    HtmlWindowGumpHooks h;h.node=[this](auto token) { return Find(htmlRoots,token); };h.base=common.node;h.button=[this](auto token)->ButtonGumpNode* { return Find(helpButtons,token); };
    h.constructDecoration=[this](auto token) { decoration->Construct(token,0,0); };h.destructBase=[this](auto token) { common.lifetime.DestructBase(token); };h.push=[this](auto token) { common.tree.Push(token); };h.kill=[this](auto token) { common.lifetime.Kill(token); };
    h.allocate=[this](auto bytes) { const auto token=AllocateHelp(bytes);htmlOwned.insert(token);return token; };
    h.constructButton=[this](auto token,auto label) { const auto text=std::string(label);common.stones.Construct(token,0,0,text.c_str(),palette.named.at(9).index); };
    h.constructBody=[this](auto token) { titleWidgets->Construct(token,0,0,0,palette.basic[7]); };h.parseBody=[this](auto token,auto source) { titleMarkup->Parse(token,source); };h.scrollable=[this](auto token,auto value) { titleWidgets->SetScrollable(token,value); };
    h.attach=[this](auto token,auto x,auto y,auto parent,auto mode) { Attach(token,x,y,parent,mode); };h.reference=[this](auto serial) { return Reference(serial); };
    h.wallSeconds=[this] { if (!htmlContext->wallSeconds) throw std::logic_error("HTML 실제 벽 시각 미연결");return htmlContext->wallSeconds(); };
    h.queue=[this](auto event,auto first,auto second) { if (!htmlContext->queue) throw std::logic_error("HTML 실제 원시 입력 큐 미연결");htmlContext->queue(event,first,second); };h.link=[this](auto token) { if (!htmlContext->link) throw std::logic_error("HTML 실제 링크 미연결");htmlContext->link(token); };
    h.baseHandle=[this](auto token,auto event,auto first,auto second) { return BaseHelp(token,event,first,second); };
    HtmlWindowFitHooks fit;fit.node=h.node;fit.base=common.node;fit.fitButton=[this](auto token) { common.stones.FitToText(token); };fit.push=[this](auto token) { common.tree.Push(token); };fit.fitHeight=[this](auto token) { title->FitHeight(token); };fit.fitContent=[this](auto token,auto x,auto y) { title->FitContent(token,x,y); };
    fit.slider=[this](auto token,auto value) { titleWidgets->SetSlider(token,value); };fit.scrollable=[this](auto token,auto value) { titleWidgets->SetScrollable(token,value); };fit.requestScroll=[this](auto token,auto value) { title->RequestScroll(token,value); };
    fit.attach=[this](auto token,auto x,auto y,auto parent,auto mode) { Attach(token,x,y,parent,mode); };fit.attachBase=[this](auto token,auto x,auto y,auto parent,auto mode) { common.tree.Attach(token,x,y,parent,mode); };fit.currentMenu=[this] { return menu->Current(); };fit.attachMenu=[this](auto x,auto y,auto parent) { menu->AttachCurrent(x,y,parent); };
    fit.reference=[this](auto serial) { return Reference(serial); };fit.read=[this](auto address) { if (!htmlContext->read) throw std::logic_error("HTML 실제 현재 뷰/화면 전역 미연결");return htmlContext->read(address); };fit.addDepth=[this](auto token,auto delta) { common.tree.AddDepth(token,delta); };htmlFit=std::make_unique<HtmlWindowFit>(std::move(fit));
    htmlWindow=std::make_unique<HtmlWindowGump>(htmlContext->globals->window,std::move(h));
    HtmlWindowMetadataHooks meta;meta.node=[this](auto token) { return Find(htmlRoots,token); };meta.clearButtons=[this](auto token) { htmlWindow->ClearButtons(token); };meta.addButton=[this](auto token,auto label,auto command,auto parameter,auto instant) { htmlWindow->AddButton(token,label,command,parameter,instant); };
    meta.commands.lookup=[this](auto text) { const auto& hook=htmlContext->metadata.commands.lookup;if (!hook) throw std::logic_error("HTML 실제 명령 조회 미연결");return hook(text); };meta.commands.unknown=[this](auto text) { const auto& hook=htmlContext->metadata.commands.unknown;if (!hook) throw std::logic_error("HTML 실제 명령 진단 미연결");hook(text); };
    meta.storeText=[this](auto text) { if (!htmlContext->metadata.strings) throw std::logic_error("HTML 실제80칸 문자열 고리 미연결");return htmlContext->metadata.strings->Store(text); };
    meta.beginMenu=[this](auto flags) { BeginHtmlMenu(flags); };meta.menuText=[this](auto label,auto command,auto parameter) { controls->AddText(label,command,parameter,true,true,false); };meta.checked=[this](auto checked,auto label,auto command,auto parameter,auto enabled) { controls->AddChecked(checked!=0,label,command,parameter,true,enabled); };
    meta.maps=[this](auto label,auto& columns) { auto& services=htmlContext->metadata;if (!services.maps || !services.fileSpec) throw std::logic_error("HTML 실제 맵 캐시/키 미연결");const auto mapHooks=MakeTellMapMenuHooks(*services.maps,*services.fileSpec,services.currentMap,services.fallbackMap,[this](auto flags) { BeginHtmlMenu(flags); },[this](const auto& row,auto command) { if (!htmlContext->metadata.strings) throw std::logic_error("HTML 맵 행 실제 문자열 고리 미연결");controls->AddChecked(row.checked,row.label,command,htmlContext->metadata.strings->Store(row.name),true,row.enabled); });if (!AppendTellMapMenus(label,columns,mapHooks)) throw std::logic_error("HTML 실제 맵 분기 불일치"); };
    meta.tech=[this](auto value) { const auto& hook=htmlContext->metadata.tech;if (!hook) throw std::logic_error("HTML 실제 기술 목록 미연결");hook(value); };meta.themeTech=[this](auto type,auto theme) { const auto& hook=htmlContext->metadata.themeTech;if (!hook) throw std::logic_error("HTML 실제 테마 기술 목록 미연결");hook(type,theme); };
    meta.namedList=[this](auto key,auto command,auto argument) { const auto& hook=htmlContext->metadata.namedList;if (hook) hook(key,command,argument);else AppendHtmlFiles(key,command,argument,true); };meta.fileList=[this](auto key,auto command,auto argument) { const auto& hook=htmlContext->metadata.fileList;if (hook) hook(key,command,argument);else AppendHtmlFiles(key,command,argument,false); };meta.inlineList=[this](auto key,auto command,auto argument) { const auto& hook=htmlContext->metadata.inlineList;if (hook) return hook(key,command,argument);if (!htmlContext->metadata.fileMenus) throw std::logic_error("HTML 실제 삽입 목록 미연결");return htmlContext->metadata.fileMenus->Inline(key,command,argument); };
    meta.wallSeconds=htmlContext->wallSeconds;meta.idle=[this](auto token,auto enabled) { common.lifetime.SetIdle(token,enabled); };meta.read=[this](auto address) { if (!htmlContext->read) throw std::logic_error("HTML 실제 메타 전역 미연결");return htmlContext->read(address); };meta.queue=[this](auto command,auto first,auto second) { if (!htmlContext->queue) throw std::logic_error("HTML 실제 메타 원시 큐 미연결");htmlContext->queue(command,first,second); };
    meta.input=[this](auto limit,auto label,auto argument) { const auto& hook=htmlContext->metadata.input;if (!hook) throw std::logic_error("HTML 실제 입력 창 미연결");hook(limit,label,argument); };meta.send=[this](auto label,auto command,auto argument) { const auto& hook=htmlContext->metadata.send;if (!hook) throw std::logic_error("HTML 실제 Zsend 장치 미연결");hook(label,command,argument); };htmlMetadata=std::make_unique<HtmlWindowMetadata>(std::move(meta));
    HtmlWindowFactoryHooks factory;factory.create=[this](auto width,auto height) { return AllocateHtml(width,height); };factory.node=[this](auto token) { return Find(htmlRoots,token); };
    factory.substitute=[this](auto text,auto capacity) { const auto& hook=htmlContext->factory.substitute;if (!hook) throw std::logic_error("HTML 전체 실제 Config 치환 미연결");return hook(text,capacity); };factory.fallback=[this] { const auto& hook=htmlContext->factory.fallback;if (!hook) throw std::logic_error("HTML 전체 실제 OkButton 조회 미연결");return hook(); };factory.parse=[this](auto& parser,auto root,auto text,auto capacity) { return ParseHtml(parser,root,text,capacity); };factory.metadata=[this](auto token,auto buffer) { return htmlMetadata->Process(token,buffer); };factory.wallSeconds=htmlContext->wallSeconds;
    factory.body=[this](auto token,auto text) { htmlWindow->SetBody(token,text); };factory.attach=[this](auto token,auto x,auto y,auto parent,auto mode) { Attach(token,x,y,parent,mode); };factory.modal=[this](auto token,auto enabled) { SetModal(token,enabled); };factory.kill=[this](auto token) { common.lifetime.Kill(token); };factory.read=[this](auto address) { if (!htmlContext->read) throw std::logic_error("HTML 전체 실제 화면/루트 미연결");return htmlContext->read(address); };htmlFactory=std::make_unique<HtmlWindowFactory>(htmlContext->globals->window,std::move(factory));
}
void AppendHtmlFiles(std::string_view key,std::uint32_t command,std::string_view argument,bool emptyTitleUsesName) { // 실제 @/# 목록을 같은 controlled 메뉴/고리에 직접 작성한다.
    auto& services=htmlContext->metadata;if (!services.fileMenus || !services.strings) throw std::logic_error("HTML 실제 파일 목록/공유 고리 미연결");services.fileMenus->Append(key,command,argument,emptyTitleUsesName,*services.strings,[this](const auto& item) { if (item.separator) controls->AddSeparator();else controls->AddText(item.label,item.command,item.parameter,true,true,false); });
}
std::uint32_t AllocateHtml(std::uint32_t width,std::uint32_t height) { const auto token=common.token();htmlRoots.emplace(token,std::make_unique_for_overwrite<HtmlWindowGumpNode>());htmlOwned.insert(token);const auto result=htmlWindow->Construct(token,width,height);htmlConstructed.insert(token);return result; } // 같은 실제 전체 파생 할당/생성을 공장과 직접 생성이 공유한다.
std::string ParseHtml(HtmlTextParserState& parser,std::uint32_t root,std::string_view source,std::uint32_t capacity) { // 같은 두 번 파서의 현재 전역과 실제 부모 링크를 연결한다.
    auto& services=htmlContext->factory;if (!services.globals) throw std::logic_error("HTML 전체 실제 파서 전역 미연결");auto parserHooks=services.html;HtmlLinkTextState links;links.enabled=root!=0;links.capacity=8192;
    if (root) { auto found=htmlLinkBases.find(root);if (found==htmlLinkBases.end()) { if (nextHtmlLinkBase>0x7fffe000U) throw std::overflow_error("HTML 부모 링크 주소 별칭 소진");found=htmlLinkBases.emplace(root,nextHtmlLinkBase).first;nextHtmlLinkBase+=8192; }links.base=found->second;const auto& bytes=Find(htmlRoots,root)->html;links.bytes.assign(bytes.begin(),bytes.end()); }
    parserHooks.link=[this,root,&links](auto&,auto raw,auto closing) { if (root) { const auto& bytes=Find(htmlRoots,root)->html;links.bytes.assign(bytes.begin(),bytes.end()); }const auto text=HtmlLinkText(links,raw,closing);if (root) std::copy(links.bytes.begin(),links.bytes.end(),Find(htmlRoots,root)->html.begin());return text; }; // 각 링크 효과 직후 실제8192BYTE에 쓰므로 다음 명령/조건도 현재 바이트를 읽는다. cursor만 첫 위치로 되돌리고 이전 바이트를 지우지 않는다.
    return HtmlTextParser(parser,*services.globals,std::move(parserHooks),o::OriginalEdition::Patch1078).Parse(source,static_cast<std::int32_t>(capacity));
}
std::string HtmlLink(std::uint32_t token) const { // 죽음 비트 대신 실제 소유 저장소의 반납 시점을 검사한다.
    for (const auto& [root,base]:htmlLinkBases) if (token>=base && token-base<8192) { const auto* node=Find(htmlRoots,root);if (!node) break;const auto begin=node->html.begin()+(token-base),end=std::find(begin,node->html.end(),'\0');if (end==node->html.end()) throw std::length_error("HTML 실제 링크 NUL 범위 초과");return std::string(begin,end); } // Kill→링크 실행→Cleanup 순서의 같은 부모 바이트를 읽는다.
    throw std::out_of_range("HTML 반납되었거나 없는 링크 주소");
}
void FindModalLowest(std::uint32_t token,std::vector<std::uint32_t>& active) { //464090의 visible/alive/nonvoid 자식과 현재 signed 깊이를 원문 순서로 읽는다.
    if (active.size()>=kGumpRegistryCapacity || std::find(active.begin(),active.end(),token)!=active.end()) throw std::logic_error("모달 최소 깊이 트리 순환/한도");active.push_back(token);std::set<std::uint32_t> seen;
    for (auto child=common.node(token)->child;child;child=common.node(child)->next) { if (!seen.insert(child).second) throw std::logic_error("모달 최소 깊이 형제 순환");const auto* node=common.node(child);if ((node->flags&1) && !(node->flags&0x10008)) { const auto depth=std::bit_cast<std::int32_t>(node->depth);if (depth<modalMinimumDepth) { modalMinimumDepth=depth;modalLowest=child; }FindModalLowest(child,active); } } // 재귀 전 자식의 깊이를 먼저 비교해 같은 깊이일 때 선택 노드를 보존한다.
    const auto depth=std::bit_cast<std::int32_t>(common.node(token)->depth);if (depth<modalMinimumDepth) { modalMinimumDepth=depth;modalLowest=token; }active.pop_back();
}
void SetModal(std::uint32_t token,bool enabled) { //466600의 같은 dialog 표와 이전 창 전체의 가장 낮은 자식 깊이를 사용한다.
    if (!enabled) common.lifetime.RemoveDialog(token);else if (common.input.AddDialog(token) && common.life.dialogCount>1) { modalMinimumDepth=10000;modalLowest=0;std::vector<std::uint32_t> active;FindModalLowest(common.life.dialogs[common.life.dialogCount-2],active);if (!modalLowest) throw std::logic_error("원문 모달 최소 깊이 assertion504");common.tree.AddDepth(token,common.node(modalLowest)->depth-common.node(token)->depth-3U); }common.changed();
}
void BeginHtmlMenu(std::uint32_t flags) { const auto token=widgets->BeginVertical(flags);htmlOwned.insert(token); } // 부착 전 실패한 controlled 메뉴도 같은 실제 수명으로 정리한다.
std::uint32_t CreateHtml(RawHtmlWindowContext context,std::uint32_t width,std::uint32_t height) { // 원문 new0x21e8에 실제 고정 파생 저장소를 제공한다.
    BindHtml(std::move(context));return AllocateHtml(width,height);
}
void CloseHtml() { // 부분 생성/미부착/교체 중인 실제 소유 노드도 같은 공통 수명으로 정리한다.
    while (menu->Current() && htmlOwned.contains(menu->Current())) menu->TakeCurrent(); // 메타 생성 중 실패한 실제 상단 예약 칸을 먼저 반납한다.
    for (std::size_t id=1;id<common.create.entries.size();++id) { const auto token=common.create.entries[id];if (htmlOwned.contains(token) && !(common.node(token)->flags&0x10000)) common.lifetime.Kill(token); } // 자식 우선 정리는 같은 공통 Cleanup이 수행한다.
    common.lifetime.Cleanup();
    for (const auto token:htmlOwned) { if (std::find(common.create.entries.begin(),common.create.entries.end(),token)!=common.create.entries.end()) throw std::logic_error("HTML 정리 뒤 실제 등록 노드 잔류");htmlLinkBases.erase(token);htmlRoots.erase(token); } // 기본 생성 전 실패의 실제 저장소만 반납한다.
    htmlOwned.clear();htmlConstructed.clear();common.changed();
}
