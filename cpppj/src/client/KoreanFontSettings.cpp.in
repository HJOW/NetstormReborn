const char kKoreanFontRegularFile[] = "@NETSTORM_KOREAN_regular@"; // 일반 TTF의 파일명이다.
const char kKoreanFontBoldFile[] = "@NETSTORM_KOREAN_bold@"; // 굵은 TTF의 파일명이다.
const char kKoreanFontLicenseFile[] = "@NETSTORM_KOREAN_license@"; // 글꼴 허가 문서 파일명이다.
}
