{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Windows - Visual Studio 2022 (x64)",
      "description": "Windows 10/11 용. 빌드 폴더: build/vs2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja",
      "displayName": "Ninja (Release)",
      "description": "컴파일러가 PATH 에 있는 Windows 환경(개발자 명령 프롬프트)용. 빌드 폴더: build/ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "ninja", "configurePreset": "ninja" }
  ],
  "testPresets": [
    {
      "name": "vs2022",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "output": { "outputOnFailure": true }
    }
  ]
}
