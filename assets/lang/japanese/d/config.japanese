// 원래 입력 명령과 치환값의 기본 문자열도 보존한다.
OkButton = "$Button=OK,DoNothing,0"
WindowName = "NetStorm マルチプレイヤーゲーム `"{local.1}`" 所有者: {fort.mySubHandle|未登録}"
BlankWindowName = "NetStorm メインメニュー"
MissionWindowName = "NetStorm ミッション `"{local.1}`""
