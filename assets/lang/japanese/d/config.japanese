crash HTML = "<p>この情報をコピーし、<a href=`"mailto:bugs@titanic.com`">メールで送信してください</a>。`n<p>`n<a href=`"{troubleshooting URL}`">トラブルシューティングを開きます。</a><hr>(このブラウザー起動を無効にするには、options.cfg の troubleshootOnCrash を 0 に設定してください。)`n"
crash TXT = "アサーションに失敗しました:`n'%s'、ファイル '%s'、行 %d、バージョン %d。`nこの情報をコピーし、bugs@titanic.com に送信してください。`n"
readonly = "読み取り専用! "
newFort = "MyOnlineGame"

// 현재 비활성인 레거시 설치/외부 서비스 문자열은 번역만 하며 실행 경로를 활성화하지 않는다.
RelShortcut0 = "\NetStorm.exe,,NetStorm,NetStorm 実行ファイル,"
RelShortcut1 = "\nsutil.exe,diagnose,NetStorm 診断,NetStorm 診断ツール,"
RelShortcut2 = "\nsutil.exe,uninstall,NetStorm 削除,NetStorm 削除ツール,"
RelShortcut3 = "\Help\Help.exe,Readme.hlp,Technical Help,NetStorm 技術ヘルプ,\help"
DemoShortcut0 = "\NetStorm.exe,,NetStorm Demo,NetStorm 実行ファイル,"
DemoShortcut1 = "\nsutil.exe,diagnose,NetStorm Demo Diagnostics,NetStorm 診断ツール,"
DemoShortcut2 = "\nsutil.exe,uninstall,Uninstall NetStorm Demo,NetStorm 削除ツール,"
DemoShortcut3 = "\Help\Help.exe,Readme.hlp,Technical Help,NetStorm 技術ヘルプ,\help"
