[options]
[A.]
                               <h2>Repairing of THUNDER city<a href="#mission16">~[IfortGump.46]</a></h2>
                                     ~[Ibulf.80]
<br>                                                                                  ~1~y<?!{sw_difficulty1}>HARD</?><?{sw_difficulty1}>EASY</?>~.<br>
                                     The Thunder Fury appears.<br>
<i>"Priest, please help my Ambassador and Guardian rebuild this city.
They need to build a temple on one of the islands so that they can reclaim the city and aid you in the defense.
Beware, the evil spirits of Hades have created havoc in these parts now. Be careful!" </i>
<p>
                  <a href="cmd:ShowTechnology,55"> ~[IfortGump.50] </a>                            <a href="cmd:DoNothing,0">~[IfortGump.22] </a>                     <a href="cmd:Tell,guideHades.overview">~[Ipriest.13]</a><br>
        <a href="cmd:ShowTechnology,55">Review Knowledge</a>      <a href="cmd:DoNothing,0">    Let's go!    </a>      <a href="cmd:Tell,guideHades.overview">Leave mission</a>
<$PlaySound,thunderCrack.wav>
<$PlaySound,bulfhurt.wav>
<$PlaySound,burning.wav>
<$Tell,sound1>
$OnExit= ,PlaySound,priestmove1.wav
$Button= ,Tell,A.

[sound1]
<$Config,sw_soundFlag=1>
$Timeout=0,Tell,sound2
[sound2]
<$Config,sw_soundFlag=0>
$Timeout=0,Tell,sound3
[sound3]
<$Config,sw_soundFlag=1>
$Timeout=0,Tell,sound4
[sound4]
<$Config,sw_soundFlag=0>
<$PlaySound,bulfhurt.wav>


[ai2PriestDead][ai7PriestDead]
<h2>You receive a message from the {sw_god5}.</h2><br>
<i>You got lucky by killing 1 of my spirits.<br>
It won't happen again.</i>
$Button=OK,Tell,showmenu

[ai8PriestDead]
<h2>The Guardian of Thunder City is dead!</h2>
<i>You have let one of your allies die!<br>
It will be harder to rebuild with out his aid.</i>
<$PlaySound,eagleScream-1500.wav>
$Button=OK,DoNothing,0

[ai8PriestCaptured]
<h2>You receive a message from the {sw_god5}</h2><br>
<i>"My spirits have captured your precious ally.<br>
He will soon be in my collection of souls."</i>
$Button=OK,tell,more1

[more1]
<h2>You receive a message from Theorian!</h2>
<i>Ally, Don't worry about me.</i><br>
<p>Save yourself!
I will grant you knowledge to aid in your quest of safety!
$Button=OK,Tell,showmenu


[showMenu]
<$MoveDialog,tr>
King {sw_hades} is pleased! He grants you a choice:
<?{sw_weapon1}>$Menu=~kThunder Generator,Tell,showMenu</?>
<?!{sw_weapon1}>$Menu=~yThunder Generator,Tell,thunderGen</?>
<?{sw_weapon2}>$Menu=~kMad Cow (Bulf),Tell,showMenu</?>
<?!{sw_weapon2}>$Menu=~yMad Cow (Bulf),Tell,cow</?>
<?{sw_weapon3}>$Menu=~kArc Spire,Tell,showMenu</?>
<?!{sw_weapon3}>$Menu=~yArc Spire,Tell,arkSpire</?>
<?{sw_weapon4}>$Menu=~kBulwark,Tell,showMenu</?>
<?!{sw_weapon4}>$Menu=~yBulwark,Tell,bulwark</?>
<?{sw_weapon5}>$Menu=~kThunder Cannon,Tell,showMenu</?>
<?!{sw_weapon5}>$Menu=~yThunder Cannon,Tell,thunderCannon</?>
<?{sw_weapon6}>$Menu=~kVander Tower,Tell,showMenu</?>
<?!{sw_weapon6}>$Menu=~yVander Tower,Tell,vanderTower</?>
<$Playsound,bell.wav>
$Button=No I don't want anything,DoNothing,0


[thunderGen]
<$Config,sw_weapon1=1>
<$GetTechnology,77>
$Timeout=0,DoNothing,0

[cow]
<$Config,sw_weapon2=1>
<$GetTechnology,135>
$Timeout=0,DoNothing,0

[arkSpire]
<$Config,sw_weapon3=1>
<$GetTechnology,149>
$Timeout=0,DoNothing,0

[bulwark]
<$Config,sw_weapon4=1>
<$GetTechnology,79>
$Timeout=0,DoNothing,0

[thunderCannon]
<$Config,sw_weapon5=1>
<$GetTechnology,131>
$Timeout=0,DoNothing,0

[vanderTower]
<$Config,sw_weapon6=1>
<$GetTechnology,148>
$Timeout=0,DoNothing,0



[Succeeded][BadTeamDead]
<h2>SUCCESS!</h2>
You have helped the Thunder Ambassador rebuild Thunder City! For that, the
Thunder Fury takes a keen interest in you. You have now been allied with Thunder
and have become one of the Furies apprentices.
<$Config,sw_m16=0>
<$Config,sw_m19=1>
<$Config,sw_difficulty1=0>
$Button=ONTO CHOICE OF THE FURIES,MissionBegin,sw_m19



[Failed][ai6PriestDead]
The ambassador of Thunder City is dead!
<$PlaySound,eagleScream-1500.wav>
You have let down the Thunder Fury! He is furious!
<?!{sw_difficulty1}>
<br><i>I cannot protect you again. Don't fail again. {sw_hades}
is too powerful!</i>
<$Config,sw_difficulty1=1>
<$Config,sw_mvar0=7000>
<$Config,sw_mvar1=8000>
<$Config,sw_mvar2=2>
<$Config,sw_mvar3=2000>
<$Config,sw_mvar4=5>
$Button=Try again,MissionBegin,sw_m16
</?>

<?{sw_difficulty1}>
In a blinding flash of power, a thunder Cannon explosion
erupts in front of you and strikes you down!
When you recover, you find that the {sw_god5}
has brought you to {sw_hades} for torment!
<$Config,sw_m16=0>
<$Config,sw_m24=1>
<$Config,sw_difficulty1=0>
$Button=ONTO HADES ALTAR,MissionBegin,sw_m24
</?>
[END]
