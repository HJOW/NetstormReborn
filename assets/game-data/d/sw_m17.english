[ai2PriestCaptured]
<$PlaySound,priestPickUp.wav>
      <h2>You recieve a message from the<br>
               {sw_god5}</h2>
<p>
                              ~y~BHelp me you fool!<br>
                    Can't you see I'm in trouble!
<p>
<i>Here is some extra storm power to aid you with<br>
                                   my escape.</i>
<$ChangeMoney,1500>
$OnExit= ,PlaySound,GolemMove5.wav
$Button=Sorry Hades. I will try to help you!,DoNothing,0


[ai2PriestDead]
<$Config,sw_enDead2=1>
<$PlaySound,priestSacrifice2.wav>
<h2>You receive a message from the<br>
{sw_god1}  </h2>
<p>~y~IHaha! Hades is gonna be trapped forever now. Wait until I get my hands on you.
<$PlaySound,whale.wav>
$OnExit= ,Tell,checkwin
$Button=OhOH!,DoNothing,0

[ai3PriestCaptured]
<$PlaySound,priestStruggleFade01.wav>
<$PlaySound,select.wav>
<h2>You receive a message from the {sw_god5}</h2>
<p>
<i>Don't you sacrifice him until I get there!</i>
<p><br>
<h2>You receive a message from the {sw_god2}</h2>
<p>
<i>Priest, I  would like for us to conquer this battle together.
Will you accept an alliance with me?</i>
$Button = I'd be honored OH GREAT FURY!,Tell,AllianceBegunWind
$Button = Are you on Nimbus Dust?,Tell,NoDeal
$Timeout = 25,Tell,AllianceWithdrawn

[AllianceBegunWind]
<$PlaySound,distantWindQuiet-3000.wav>
<$PlaySound,treasonCast.wav>
<$PlaySound,distantWindQuiet-3000.wav>
You have allied yourself with the {sw_god2}!<br>
                  ~[IwindVortex.20]
<p>
Needless to say, {sw_god5} is very MAD!
$OnExit= ,PlaySound,forWind2.wav
