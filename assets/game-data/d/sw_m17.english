<$Config,sw_m17=0>
<$Config,sw_m18=1>
<$Config,sw_difficulty1=0>
<$Config,sw_FuryTrapped=0>
<$Config,sw_droppedPriest=0>
$Button=ON with THE ALLIANCE!,MissionBegin,sw_m18


[AllianceWithdrawn]
<$PlaySound,dissolve.wav>
<$Config,sw_pickally1=0>
<p>You took too long to respond.  You're on your own, now!
$Button=Continue,DoNothing,0

