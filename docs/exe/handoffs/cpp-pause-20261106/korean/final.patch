+    catch (...) { suppressEnglishFallback=previous;throw; }
+}
 std::uint32_t BaseFileSystem::Probe(std::string_view name) const {
     return ProbeWithDiskName(name,{}); // 기존 존재조회 소비자는 새 인코딩 장치를 요구하지 않는다.
 }
