# 셸 스크립트는 Windows 체크아웃(core.autocrlf=true)에서도 LF 를 유지해야 리눅스·WSL 에서 실행된다
*.sh text eol=lf
# 기존 게임 포맷의 인코딩·CRLF·공백을 보존해 Windows 체크아웃에서도 이관 해시와 데이터가 유지되게 한다.
assets/game-data/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# 기계어 검증 목록·기대값의 SHA-256을 Windows 체크아웃에서도 동일하게 유지한다.
cpppj/recovery-manifest.json text eol=lf
cpppj/recovery-evidence.json text eol=lf
cpppj/recovery-graphics-evidence.json text eol=lf
cpppj/recovery-bridge-evidence.json text eol=lf
tools/decomp_bridge_oracle.py text eol=lf
cpppj/recovery-surface-evidence.json text eol=lf
tools/decomp_surface_oracle.py text eol=lf
# 새 표면 검증이 참조하는 공통 실행 도구도 체크아웃마다 같은 해시를 유지한다.
tools/decomp_oracle.py text eol=lf
# 공간 해시 검증의 기록과 생성 도구도 SHA-256 재현을 위해 LF로 고정한다.
cpppj/recovery-hash-evidence.json text eol=lf
tools/decomp_hash_oracle.py text eol=lf
# 공간 등록 검증의 조건부 실행 기록과 도구를 동일한 SHA-256으로 보존한다.
cpppj/recovery-spatial-evidence.json text eol=lf
tools/decomp_spatial_oracle.py text eol=lf
# SID 검증의 생성 도구/헤드리스 스크립트/기록도 같은 SHA-256을 유지한다.
cpppj/recovery-sid-evidence.json text eol=lf
tools/decomp_sid_oracle.py text eol=lf
tools/ghidra/ExportSid.java text eol=lf
cpppj/tests/fixtures/*.tsv text eol=lf
# 생성자 표/기본 초기화의 독립 검증 자료와 생성 소스 해시를 보존한다.
cpppj/recovery-creation-evidence.json text eol=lf
cpppj/src/o/TypeConstructors.inc text eol=lf
tools/decomp_creation_oracle.py text eol=lf
tools/ghidra/ExportCreation.java text eol=lf
# 자산 파생 생성자 검증의 도구/기록/raw 쓰기 표를 같은 SHA-256으로 유지한다.
cpppj/recovery-derived-evidence.json text eol=lf
cpppj/src/o/DerivedConstructors.inc text eol=lf
tools/decomp_derived_oracle.py text eol=lf
# raw 공간 해제의 기계어 검증 기록·도구·가상 주소 표를 재현 가능한 LF로 고정한다.
cpppj/recovery-unpop-evidence.json text eol=lf
cpppj/src/o/UnpopVtables.inc text eol=lf
tools/decomp_unpop_oracle.py text eol=lf
# raw Pop의 기계어 검증 기록/도구/공통 가상 표를 같은 SHA-256으로 보존한다.
cpppj/recovery-pop-evidence.json text eol=lf
cpppj/src/o/PopVtables.inc text eol=lf
tools/decomp_pop_oracle.py text eol=lf
# 표시 활성 검증의 도구와 기록을 동일한 SHA-256으로 유지한다.
tools/decomp_display_oracle.py text eol=lf
cpppj/recovery-display-evidence.json text eol=lf
