# 셸 스크립트는 Windows 체크아웃(core.autocrlf=true)에서도 LF 를 유지해야 리눅스·WSL 에서 실행된다
*.sh text eol=lf
# 기존 게임 포맷의 인코딩·CRLF·공백을 보존해 Windows 체크아웃에서도 이관 해시와 데이터가 유지되게 한다.
assets/game-data/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# 기계어 검증 목록·기대값의 SHA-256을 Windows 체크아웃에서도 동일하게 유지한다.
cpppj/recovery-manifest.json text eol=lf
cpppj/recovery-evidence.json text eol=lf
cpppj/recovery-graphics-evidence.json text eol=lf
cpppj/recovery-bridge-evidence.json text eol=lf
tools/decomp_bridge_oracle.py text eol=lf
cpppj/recovery-surface-evidence.json text eol=lf
tools/decomp_surface_oracle.py text eol=lf
# 새 표면 검증이 참조하는 공통 실행 도구도 체크아웃마다 같은 해시를 유지한다.
tools/decomp_oracle.py text eol=lf
# 공간 해시 검증의 기록과 생성 도구도 SHA-256 재현을 위해 LF로 고정한다.
cpppj/recovery-hash-evidence.json text eol=lf
tools/decomp_hash_oracle.py text eol=lf
cpppj/tests/fixtures/*.tsv text eol=lf
